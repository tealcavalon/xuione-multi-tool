# Never serve the raw access logs over HTTP, even though the parent directory
# is already behind Basic auth. Belt and braces.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (fallback)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
